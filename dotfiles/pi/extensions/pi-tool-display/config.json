{
  "debug": false,
  "registerToolOverrides": {
    "read": true,
    "grep": true,
    "find": true,
    "ls": true,
    "bash": true,
    "edit": true,
    "write": true
  },
  "customToolOverrides": {
    "firecrawl_scrape": { "kind": "generic", "outputMode": "summary" },
    "firecrawl_crawl": { "kind": "generic", "outputMode": "summary" },
    "firecrawl_crawl_status": { "kind": "generic", "outputMode": "summary" },
    "firecrawl_map": { "kind": "generic", "outputMode": "summary" },
    "firecrawl_search": { "kind": "generic", "outputMode": "summary" }
  },
  "enableNativeUserMessageBox": false,
  "readOutputMode": "summary",
  "searchOutputMode": "count",
  "mcpOutputMode": "summary",
  "previewLines": 8,
  "expandedPreviewMaxLines": 4000,
  "bashOutputMode": "opencode",
  "bashCollapsedLines": 10,
  "diffViewMode": "unified",
  "diffIndicatorMode": "classic",
  "diffSplitMinWidth": 120,
  "diffCollapsedLines": 24,
  "diffWordWrap": true,
  "showTruncationHints": false,
  "showRtkCompactionHints": false
