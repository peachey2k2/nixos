-          let (px, py) =
-            (origin_x + glyph.left + gx, baseline - glyph.top + gy);
+          let px = origin_x + glyph.left + gx;
@@ -2208,0 +2216,2 @@ mod tests {
+    Glyph,
+    GlyphData,
@@ -2209,0 +2219 @@ mod tests {
+    blit_glyph,
@@ -2319,0 +2330,39 @@ mod tests {
+  #[test]
+  fn ordinary_glyph_ink_is_clipped_to_its_row() {
+    let mut buf = vec![0u8; 8 * 4];
+    let mut canvas = Canvas {
+      pixels: &mut buf,
+      width:  1,
+      height: 8,
+      blend:  AlphaBlending::Native,
+    };
+    let metrics = CellMetrics {
+      width:  1,
+      height: 4,
+      ascent: 3,
+      stroke: 1,
+    };
+    // At cell_top=2 this bitmap would occupy y=3..=6, one pixel below the
+    // row's y=2..6 band, without explicit clipping.
+    let glyph = Glyph {
+      left:   0,
+      top:    2,
+      width:  1,
+      height: 4,
+      data:   GlyphData::Mask(vec![255; 4]),
+    };
+    blit_glyph(
+      &mut canvas,
+      &glyph,
+      metrics,
+      0,
+      2,
+      0,
+      Rgb(255, 255, 255),
+      None,
+    );
+
+    assert_ne!(buf[5 * 4], 0, "ink inside the row should be drawn");
+    assert_eq!(buf[6 * 4], 0, "ink below the row must be clipped");
+  }
+
